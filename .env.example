# Copy this file to .env for local development. Never commit the real .env.

# Local development
DEBUG=True
# Generate a stable local key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Local development uses the media/ directory by default.
USE_CLOUD_STORAGE=False

# Set USE_CLOUD_STORAGE=True on the deployed website.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=studybee-resources
SUPABASE_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_PROJECT_REGION
SUPABASE_PUBLIC_MEDIA_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/studybee-resources

# Production examples — set these in the hosting dashboard, not in this file:
# DEBUG=False
# SECRET_KEY=<unique 50+ character random value>
# ALLOWED_HOSTS=your-app.example-host.com
# CSRF_TRUSTED_ORIGINS=https://your-app.example-host.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600

# Verified BRACU student email login
BRACU_ALLOWED_EMAIL_DOMAIN=g.bracu.ac.bd
STUDENT_PASSWORD_MIN_LENGTH=8
STUDENT_OTP_LIFETIME_MINUTES=10
STUDENT_OTP_MAX_REQUESTS_PER_HOUR=5
STUDENT_OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
# Existing Brevo variables are used to deliver OTP and workflow emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=StudyBee
